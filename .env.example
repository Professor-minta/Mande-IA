PORT=3001
NODE_ENV=production
SESSION_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash

DJELIA_API_KEY=

GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HF_TOKEN=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Modèle local de secours si Claude ne répond pas. Laisser OLLAMA_MODEL vide
# tant qu'Ollama n'est pas installé sur le serveur (il faut 8 Go de RAM).
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# WhatsApp Cloud API (Meta). Ne jamais partager ces valeurs.
# WHATSAPP_TEST_MODE=true : Mande-IA ne répond qu'au numéro WHATSAPP_TEST_RECIPIENT
# (format international, ex. 22377295259 ; plusieurs numéros séparés par des virgules). Passer à false pour tout le monde,
# ce qui exige META_APP_SECRET.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Phone number ID du numéro (WhatsApp → API Setup), différent de l'App ID. Sert au profil :
# les réponses partent toujours du numéro qui a reçu le message.
WHATSAPP_PHONE_NUMBER_ID=
# Facultatif : ID du compte WhatsApp Business (WhatsApp Manager → Paramètres du compte), pour le diagnostic.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_MODE=true
# Messages gratuits par jour et par numéro WhatsApp (0 = sans limite).
WHATSAPP_DAILY_LIMIT=5
META_APP_SECRET=
# Identifiant de l'app Meta (App settings → Basic → App ID), utilisé par scripts/whatsapp.js.
META_APP_ID=
META_GRAPH_API_VERSION=v26.0

PAIEMENT_MERCHANT_ID=
PAIEMENT_API_KEY=
PAIEMENT_SECRET_TOKEN=
