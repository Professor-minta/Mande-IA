# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Gateway to multi-LLM models (Claude, Mistral, Llama, etc.)
OPENROUTER_API_KEY=

# EXA_API_KEY: Real-time semantic web search API for grounding and live knowledge
EXA_API_KEY=

# DJELIA_API_KEY: Djelia.cloud Voice API key for authentic Bamanankan TTS & Speech synthesis (https://djelia.cloud)
DJELIA_API_KEY=

# DATABASE_URL: PostgreSQL connection URI (e.g. postgresql://user:pass@localhost:5432/mande_ia)
DATABASE_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
